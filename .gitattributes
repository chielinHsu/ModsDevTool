# Normalize line endings. Text is LF in the repository and in the working copy,
# so mod content hashes are the same on every platform.
* text=auto eol=lf

# Windows-only scripts need CRLF on checkout
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.woff2 binary
